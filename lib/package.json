{
  "name": "imoen",
  "version": "2.0.0",
  "type": "module",
  "description": "Create LQIP (Low Quality Image Placeholder) from images",
  "author": "Tim Carry <tim@pixelastic.com>",
  "homepage": "https://projects.pixelastic.com/imoen/",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixelastic/imoen"
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "yarn@4.18.0",
  "files": [
    "./*.js"
  ],
  "exports": {
    ".": "./main.js"
  },
  "main": "./main.js",
  "devDependencies": {
    "get-port": "5.1.1",
    "jest-environment-node": "27.5.1"
  },
  "dependencies": {
    "firost": "5.11.0",
    "fs-extra": "11.3.4",
    "golgoth": "3.1.0",
    "node-vibrant": "4.0.4",
    "sharp": "0.34.5"
  },
  "scripts": {
    "build": "cd .. && ./scripts/build",
    "build:prod": "cd .. && ./scripts/build-prod",
    "ci": "cd .. && ./scripts/ci",
    "cms": "cd .. && ./scripts/cms",
    "compress": "cd .. && ./scripts/compress",
    "lint": "cd .. && ./scripts/lint",
    "lint:fix": "cd .. && ./scripts/lint-fix",
    "release": "cd .. && ./scripts/release",
    "serve": "cd .. && ./scripts/serve",
    "test": "cd .. && ./scripts/test",
    "test:watch": "cd .. && ./scripts/test-watch"
  },
  "aberlaas": {
    "trustedPublisher": true
  }
